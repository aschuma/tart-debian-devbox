Global : $HOME/.config/tctl/$GLOBAL_CFG
Project: $PROJECT/$PROJECT_CFG
VM     : demo
Share  : $PROJECT

==> Env layers (later override earlier):
  + $PROJECT/.env
  + $PROJECT/.env.local

Effective environment
  API_URL                  = https://x                         # $PROJECT/.env
  API_TOKEN                = def456                            # $PROJECT/.env.local
  DB_PASSWORD              = pw                                # $PROJECT/.env
  MY_KEY                   = k                                 # $PROJECT/.env
  AUTH_HEADER              = h                                 # $PROJECT/.env
  CREDENTIAL_X             = c                                 # $PROJECT/.env
  SECRET_SAUCE             = s                                 # $PROJECT/.env
  PLAIN                    = 2                                 # $PROJECT/.env.local

