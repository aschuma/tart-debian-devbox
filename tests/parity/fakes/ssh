#!/usr/bin/env bash
# Fake `ssh` for the parity suite.
#
# Logs the full argument vector to $TCTL_FAKE_WORLD/calls.log, then emulates
# the handful of remote commands the tool issues:
#   "sudo tee '<dest>' >/dev/null && sudo chmod 644 '<dest>'"  → stdin saved to vm-files/<dest>
#   "cat '<dest>' 2>/dev/null || true"                          → prints vm-files/<dest> if present
# Anything else (interactive session, arbitrary remote command) is recorded only.
set -euo pipefail
world="${TCTL_FAKE_WORLD:?TCTL_FAKE_WORLD not set}"
printf 'ssh %s\n' "$*" >> "${world}/calls.log"

files="${world}/vm-files"
mkdir -p "${files}"

# Remote command = everything after the user@host argument.
remote=""
seen_host=0
while [[ $# -gt 0 ]]; do
  if (( seen_host )); then remote+="${remote:+ }$1"; shift; continue; fi
  case "$1" in
    -F|-i|-o|-p|-l) shift 2 ;;
    -*) shift ;;
    *@*) seen_host=1; shift ;;
    *) shift ;;
  esac
done

if [[ "${remote}" =~ ^sudo\ tee\ \'([^\']+)\' ]]; then
  dest="${BASH_REMATCH[1]}"
  mkdir -p "${files}$(dirname "${dest}")"
  cat > "${files}${dest}"
elif [[ "${remote}" =~ ^cat\ \'([^\']+)\' ]]; then
  dest="${BASH_REMATCH[1]}"
  [[ -f "${files}${dest}" ]] && cat "${files}${dest}"
  exit 0
elif [[ -z "${remote}" ]]; then
  echo "[fake ssh] interactive session"
  # Echo loop for interactive tests; exits immediately on closed/empty stdin,
  # so parity scenarios (stdin </dev/null) see only the banner above.
  while IFS= read -r line; do
    echo "echo:${line}"
  done
fi
