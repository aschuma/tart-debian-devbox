#!/usr/bin/env bash
# Fake `tart` for the sandboxed tctl CLI tests.
#
# World state lives in $TCTL_FAKE_WORLD:
#   vms/<name>/state   "running" | "stopped"
#   vms/<name>/ip      IP returned by `tart ip` when running
#   calls.log          every invocation is appended here (one line per call)
#
# Supports: list [--format json] [--quiet] [--source X], ip NAME, run ARGS…, stop NAME
set -euo pipefail
world="${TCTL_FAKE_WORLD:?TCTL_FAKE_WORLD not set}"
printf 'tart %s\n' "$*" >> "${world}/calls.log"

vm_dir="${world}/vms"
mkdir -p "${vm_dir}"

cmd="${1:-}"; shift || true
case "${cmd}" in
  list)
    fmt=text
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --format) fmt="$2"; shift 2 ;;
        --format=*) fmt="${1#--format=}"; shift ;;
        *) shift ;;
      esac
    done
    if [[ "${fmt}" == json ]]; then
      echo "["
      first=1
      for d in "${vm_dir}"/*/; do
        [[ -d "$d" ]] || continue
        n="$(basename "$d")"; s="$(cat "$d/state")"
        running=false; [[ "$s" == running ]] && running=true
        [[ $first -eq 1 ]] || echo ","
        first=0
        printf '  {"Disk":20,"Size":5,"State":"%s","Accessed":"2026-01-01T00:00:00Z","Running":%s,"Name":"%s","Source":"local"}' "$s" "$running" "$n"
      done
      echo; echo "]"
    else
      printf '%-6s %-30s %-4s %-4s %-12s %s\n' Source Name Disk Size Accessed State
      for d in "${vm_dir}"/*/; do
        [[ -d "$d" ]] || continue
        printf '%-6s %-30s %-4s %-4s %-12s %s\n' local "$(basename "$d")" 20 5 "1 day ago" "$(cat "$d/state")"
      done
    fi
    ;;
  ip)
    name="$1"
    if [[ -f "${vm_dir}/${name}/state" && "$(cat "${vm_dir}/${name}/state")" == running ]]; then
      cat "${vm_dir}/${name}/ip"
    else
      echo "tart: VM '${name}' is not running" >&2
      exit 1
    fi
    ;;
  run)
    # Last argument is the VM name; mark it running. Simulate the VM process
    # by sleeping briefly in the background (the real one blocks for the VM lifetime).
    name="${*: -1}"
    mkdir -p "${vm_dir}/${name}"
    echo running > "${vm_dir}/${name}/state"
    [[ -f "${vm_dir}/${name}/ip" ]] || echo 192.168.64.10 > "${vm_dir}/${name}/ip"
    sleep 0.2
    ;;
  stop)
    name="$1"
    echo stopped > "${vm_dir}/${name}/state"
    ;;
  *)
    echo "fake tart: unsupported command '${cmd}'" >&2
    exit 2
    ;;
esac
