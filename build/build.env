# Build-side configuration — sourced by build/provision.sh, build/with-vm.sh and the justfile.
#
# This describes the TEMPLATE image produced by Packer. It is deliberately
# separate from ~/.config/tctl/config, which configures tart-ctl.sh for the
# per-project VMs you clone from this template (`just clone <name>`).

# Name of the template image Packer builds (passed to Packer as -var vm_name).
# Treat it as a read-only baseline: clone it, don't work in it.
BUILD_VM_NAME="debian-ssh"

# Developer account inside the image (must match devbox_user in
# ansible/group_vars/all/main.yml) — used by `just reprovision` / `just tools`.
BUILD_SSH_USER="devbox"

# Private key matching ssh_key_path in vars.pkrvars.hcl (the .pub injected into
# the image) — used by `just reprovision` / `just tools`.
BUILD_IDENTITY_FILE="${HOME}/.ssh/id_ed25519_tart"
